{
  "name": "Pyron Enterprise - NBR 15866",
  "dataColors": [
    "#DC2626",
    "#EA580C",
    "#D97706",
    "#EAB308",
    "#16A34A",
    "#2563EB",
    "#0284C7",
    "#64748B"
  ],
  "background": "#F8FAFC",
  "foreground": "#0F172A",
  "tableAccent": "#2563EB",
  "good": "#16A34A",
  "neutral": "#D97706",
  "bad": "#DC2626",
  "visualStyles": {
    "*": {
      "*": {
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#E2E8F0" } },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": { "solid": { "color": "#CBD5E1" } },
            "preset": "Custom",
            "shadowColor": { "solid": { "color": "#000000" } },
            "shadowTransparency": 95,
